# Copy to .env and fill in the values. Never commit .env.

# Application under test (required)
BASE_URL=https://demowebshop.tricentis.com

# Browser for the Cucumber runner: chromium | firefox | webkit
BROWSER=chromium
# Set to false to watch the browser
HEADLESS=true
# Step / test timeout in milliseconds
TIMEOUT=30000

# Registered Demo Web Shop account (role "user")
# USER_USERNAME=your.email@example.com
# USER_PASSWORD=your-password
USER_USERNAME=
USER_PASSWORD=
